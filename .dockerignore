# Keep the build context to what the Dockerfile actually copies: go.mod/go.sum,
# cmd, internal, and the host-built client in web/dist.
.git
.gitignore
.DS_Store

# Reinstalling these is what the image build cannot do (the lockfile points at
# an authenticated registry), and copying a host-built tree in would ship
# darwin-arm64 binaries into a linux stage.
node_modules
web/node_modules

# The client sources are not compiled in the image any more — only web/dist is.
web/src
web/gen
web/package.json
web/package-lock.json
web/tsconfig.json
web/vite.config.ts
web/index.html
web/design-scratchpad*.html

# The committed placeholder. web/dist is copied over the top of it, so letting
# this in would leave a previous build's hashed assets in the embedded tree.
cmd/verso/dist
verso

# Not part of the server.
docs
proto
buf.yaml
buf.gen.yaml
Makefile
README.md
Dockerfile
**/*_test.go
**/testdata
